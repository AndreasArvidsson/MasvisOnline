{
    "name": "masvis-online",
    "version": "1.2.0",
    "type": "module",
    "scripts": {
        "clean": "rm -rf docs/*",
        "start": "vite",
        "build": "vite build",
        "lint": "npm run lint:ts && npm run lint:style && npm run lint:fmt",
        "lint:ts": "oxlint -c oxlint.config.mts --deny-warnings .",
        "lint:style": "stylelint '**/*.css' --ignore-path .gitignore",
        "lint:fmt": "oxfmt --check .",
        "fix": "npm run fix:ts && npm run fix:style && npm run fix:fmt",
        "fix:ts": "oxlint -c oxlint.config.mts --fix .",
        "fix:fmt": "oxfmt .",
        "fix:style": "stylelint '**/*.css' --ignore-path .gitignore --fix"
    },
    "dependencies": {
        "aac": "^0.1.3",
        "alac": "^0.1.0",
        "av": "^0.4.9",
        "bootstrap": "^5.3.8",
        "file-loader": "^6.2.0",
        "flac.js": "^0.2.1",
        "mp3": "^0.1.0",
        "owp.feedback": "^1.1.3",
        "owp.get-html-as-image": "^1.0.1",
        "owp.glyphicons": "^1.3.0",
        "owp.graph-react": "^1.0.0",
        "owp.graph": "^2.6.1",
        "owp.workers": "^1.1.0",
        "react-dom": "^19.2.6",
        "react": "^19.2.6"
    },
    "devDependencies": {
        "@types/av": "^0.4.4",
        "@types/node": "25.9.1",
        "@types/react-dom": "^19.2.3",
        "@types/react": "^19.2.15",
        "oxfmt": "^0.51.0",
        "oxlint-tsgolint": "^0.23.0",
        "oxlint": "^1.64.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint": "^17.11.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "vite-plugin-purgecss": "^0.2.13",
        "vite": "^8.0.14"
    }
}
