{
    "compilerOptions": {
        "module": "esnext",
        "target": "esnext",
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "types": ["node", "vite/client"],
        "noEmit": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "include": ["src", "vite.config.ts", "oxlint.config.mts"]
}
